# JASS Panel environment. The installer writes the real file to ~/.config/jass-panel/panel.env (mode 0600).
# Secrets (GitHub tokens, the Discord webhook) never go in this file; they live in the panel's database.

# The public origin of the website, used to check the Origin of every mutating request. Required; there is no default.
PANEL_PUBLIC_ORIGIN=https://example.net

# Where the daemon asks the website who the caller is. Loopback only.
SITE_INTERNAL_URL=http://127.0.0.1:3000

# Loopback port the daemon listens on. It must not collide with anything else on the machine.
PANEL_PORT=29200

# URL prefix the UI and API are served under. Must match the reverse-proxy rule.
PANEL_BASE_PATH=/panel

# Database, backups, file history and the generated server units' bookkeeping. Defaults to $XDG_DATA_HOME/jass-panel
# (~/.local/share/jass-panel). Leave unset unless you have a reason.
# PANEL_DATA_DIR=
