{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "src/shared/**/*.ts"],
  "exclude": ["src/shared/**/*.test.ts", "web/dist"]
}
